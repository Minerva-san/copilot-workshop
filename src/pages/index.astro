---
import Layout from '../layouts/Layout.astro';
import GameCard from '../components/GameCard.astro';
import PageHero from '../components/PageHero.astro';
import EmptyState from '../components/EmptyState.astro';
import { getDatabase } from '../lib/db';
import { getAllGames } from '../lib/games';
import { getAllPublishers } from '../lib/publishers';

export const prerender = true;

const games = await getAllGames(getDatabase());
const publishers = await getAllPublishers(getDatabase());
const categories = [...new Map(
  games
    .flatMap((game) => (game.category ? [game.category] : []))
    .map((category) => [category.id, category]),
).values()].sort((a, b) => a.name.localeCompare(b.name));
---

<Layout title="Tailspin Toys - Crowdfunding your new favorite game!">
  <div class="py-8">
    <PageHero
      title="Welcome to Tailspin Toys"
      subtitle="Find your next game! And maybe even back one! Explore our collection!"
    />

    <div>
      <h2 class="text-2xl font-medium mb-6 text-slate-100">Featured Games</h2>

      {games.length === 0 ? (
        <EmptyState text="No games available at the moment." />
      ) : (
        <>
          <form class="mb-8 rounded-xl border border-slate-700 bg-slate-800/60 p-6" data-testid="game-filters">
            <div class="grid gap-6 md:grid-cols-2">
              <fieldset>
                <legend class="mb-3 text-sm font-semibold text-slate-100">Categories</legend>
                <div class="grid gap-2 sm:grid-cols-2">
                  {categories.map((category) => (
                    <label class="flex items-center gap-2 text-sm text-slate-300">
                      <input
                        type="checkbox"
                        name="category-filter"
                        value={category.id}
                        class="h-4 w-4 rounded border-slate-600 bg-slate-900 text-blue-500 focus:ring-2 focus:ring-blue-500"
                        data-testid={`category-filter-${category.id}`}
                      />
                      <span>{category.name}</span>
                    </label>
                  ))}
                </div>
              </fieldset>

              <div>
                <label for="publisher-filter" class="mb-3 block text-sm font-semibold text-slate-100">Publisher</label>
                <select
                  id="publisher-filter"
                  class="w-full rounded-lg border border-slate-600 bg-slate-900 px-3 py-2 text-slate-100 focus:outline-none focus:ring-2 focus:ring-blue-500"
                  data-testid="publisher-filter"
                >
                  <option value="">All publishers</option>
                  {publishers.map((publisher) => <option value={publisher.id}>{publisher.name}</option>)}
                </select>
              </div>
            </div>

            <div class="mt-6 flex flex-wrap items-center gap-4">
              <button
                type="reset"
                class="rounded-lg border border-slate-600 px-4 py-2 text-sm font-medium text-slate-200 transition-colors hover:bg-slate-700 focus:outline-none focus:ring-2 focus:ring-blue-500"
                data-testid="clear-filters"
              >
                Clear filters
              </button>
              <p class="text-sm text-slate-400" role="status" aria-live="polite" data-testid="filter-result-count">
                Showing {games.length} games
              </p>
            </div>
          </form>

          <div class="grid grid-cols-1 gap-6 sm:grid-cols-2 lg:grid-cols-3" data-testid="games-grid">
          {games.map((game) => <GameCard game={game} />)}
          </div>
          <div class="hidden" data-testid="filter-empty-state">
            <EmptyState text="No games match the selected filters." />
          </div>
        </>
      )}
    </div>
  </div>
</Layout>

<script>
  const filterForm = document.querySelector<HTMLFormElement>('[data-testid="game-filters"]');
  const cards = [...document.querySelectorAll<HTMLElement>('[data-testid="game-card"]')];
  const resultCount = document.querySelector<HTMLElement>('[data-testid="filter-result-count"]');
  const emptyState = document.querySelector<HTMLElement>('[data-testid="filter-empty-state"]');

  filterForm?.addEventListener('input', () => {
    const selectedCategories = new Set(
      [...filterForm.querySelectorAll<HTMLInputElement>('input[name="category-filter"]:checked')]
        .map((input) => input.value),
    );
    const publisherId = filterForm.querySelector<HTMLSelectElement>('#publisher-filter')?.value ?? '';

    let visibleCount = 0;
    for (const card of cards) {
      const categoryMatches =
        selectedCategories.size === 0 || selectedCategories.has(card.dataset.gameCategoryId ?? '');
      const publisherMatches =
        publisherId === '' || card.dataset.gamePublisherId === publisherId;
      const isVisible = categoryMatches && publisherMatches;

      card.hidden = !isVisible;
      if (isVisible) visibleCount += 1;
    }

    if (resultCount) resultCount.textContent = `Showing ${visibleCount} games`;
    if (emptyState) emptyState.classList.toggle('hidden', visibleCount > 0);
  });

  filterForm?.addEventListener('reset', () => {
    requestAnimationFrame(() => filterForm.dispatchEvent(new Event('input')));
  });
</script>
